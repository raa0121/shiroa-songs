{
  "$schema": "https://unpkg.com/wrangler/config-schema.json",
  "name": "shiroa-songs",
  "compatibility_date": "2026-11-25",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false
  // The custom domain shiroa-songs.raa0121.info is managed by Terraform in the
  // infra repository, so it is not listed in routes here.
}
